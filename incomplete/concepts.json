{
  "_doc": "Edit this file to teach the checker new statements. kinds: numeric (number bound to a named quantity), categorical (regex capture compared with an IFC property), set (all listed tokens must appear in the property), rule (a fixed rule triggered by a phrase), edition (standard name plus version).",
  "concepts": [
    {"id": "span_length", "kind": "numeric", "label": "Span length", "dimension": "length",
     "aliases": ["single-span", "span length", "bridge span"],
     "ifc": {"properties": ["SpanLength"], "classes": ["IfcBridge"]}},
    {"id": "deck_width", "kind": "numeric", "label": "Deck width", "dimension": "length",
     "aliases": ["deck width", "deck"],
     "ifc": {"properties": ["DeckWidth"], "classes": ["IfcSlab", "IfcBridge"]}},
    {"id": "carriageway_width", "kind": "numeric", "label": "Carriageway width", "dimension": "length",
     "aliases": ["carriageway width", "carriageway"],
     "ifc": {"properties": ["CarriagewayWidth"], "classes": ["IfcSlab", "IfcBridge"]}},
    {"id": "longitudinal_grade", "kind": "numeric", "label": "Longitudinal grade", "dimension": "percent",
     "aliases": ["longitudinal deck grade", "longitudinal grade", "deck grade"],
     "ifc": {"properties": ["LongitudinalGrade"], "classes": ["IfcSlab", "IfcRoad"]}},
    {"id": "design_speed", "kind": "numeric", "label": "Design speed", "dimension": "speed",
     "aliases": ["design speed"],
     "ifc": {"properties": ["DesignSpeed"], "classes": ["IfcRoad"]}},
    {"id": "posted_speed", "kind": "numeric", "label": "Posted speed", "dimension": "speed",
     "aliases": ["posted speed"],
     "ifc": {"properties": ["PostedSpeed"], "classes": ["IfcRoad"]}},
    {"id": "stopping_sight_distance", "kind": "numeric", "label": "Stopping sight distance", "dimension": "length",
     "aliases": ["stopping sight distance"],
     "ifc": {"properties": ["StoppingSightDistance"], "classes": []}},
    {"id": "opening_year", "kind": "numeric", "label": "Opening year", "unitless": true,
     "aliases": ["opening year"],
     "ifc": {"properties": ["OpeningYear"], "classes": []}},
    {"id": "pile_length", "kind": "numeric", "label": "Pile length", "dimension": "length",
     "aliases": ["pile length"],
     "ifc": {"properties": ["PileLength"], "classes": ["IfcFooting"]}},
    {"id": "freeboard", "kind": "numeric", "label": "Freeboard", "dimension": "length",
     "aliases": ["freeboard"],
     "ifc": {"properties": ["Freeboard"], "classes": ["IfcAnnotation"]}},
    {"id": "pipe_diameter", "kind": "numeric", "label": "Pipe diameter", "dimension": "length",
     "aliases": ["pipe diameter", "nominal diameter"],
     "ifc": {"properties": ["NominalDiameter", "Diameter"], "classes": ["IfcPipeSegment"]}},

    {"id": "girder_material", "kind": "categorical", "label": "Girder material", "mode": "contains",
     "regex": "\\b(?P<v>steel|concrete|timber)[- ]girders?\\b",
     "ifc": {"properties": ["Material"], "classes": ["IfcBeam"]}},
    {"id": "project_number", "kind": "categorical", "label": "Project number", "mode": "exact",
     "regex": "\\bproject\\s+(?:no\\.?\\s+|number\\s+)?(?P<v>[A-Z]{2,5}-\\d{3,6})\\b",
     "ifc": {"properties": ["ProjectNumber"], "classes": []}},
    {"id": "designer", "kind": "categorical", "label": "Designer", "mode": "exact",
     "regex": "\\bcommissions\\s+(?P<v>[A-Z][A-Za-z&]*(?:\\s+[A-Z][A-Za-z&]*){0,5}\\s+(?:Ltd\\.?|Inc\\.?|Limited|Corp\\.?))",
     "ifc": {"properties": ["Designer"], "classes": []}},
    {"id": "client", "kind": "categorical", "label": "Client", "mode": "exact",
     "regex": "(?P<v>[A-Z][A-Za-z]*(?:\\s+[A-Z][A-Za-z]*){1,6}\\s+Partnership)\\s+commissions",
     "ifc": {"properties": ["Client"], "classes": []}},

    {"id": "analysis_horizons", "kind": "set", "label": "Traffic analysis horizons (years)",
     "regex": "\\b\\d+-\\s*and\\s*\\d+-year\\b", "token_regex": "\\d+",
     "ifc": {"properties": ["AnalysisHorizons"], "classes": []}},
    {"id": "drawing_sheets", "kind": "set", "label": "Required drawing sheets",
     "regex": "\\bG\\d{3}(?:\\s*/\\s*G\\d{3})+", "token_regex": "G\\d{3}",
     "ifc": {"properties": ["Sheets"], "classes": []}},

    {"id": "no_construction_release", "kind": "rule", "label": "No construction authorization",
     "regex": "\\bno\\b[^.;]{0,40}construction (?:release|authori[sz]ation)",
     "rules": [{"when": {"ProjectStatus": {"present": true}},
                "require": {"ProjectStatus": {"not_regex": "for construction|construction issue"}},
                "message": "The document says construction is not authorized, but the model status is '{actual}'."}]},
    {"id": "no_design_exception", "kind": "rule", "label": "No design exception included",
     "regex": "\\bno\\b[^.;]{0,20}design exception",
     "rules": [{"when": {"DesignExceptionStatus": {"present": true}},
                "require": {"DesignExceptionStatus": {"not_regex": "approv|grant|accept"}},
                "message": "The document says no design exception is included, but the model records one as '{actual}'."}]},
    {"id": "hydraulic_geotech_gate", "kind": "rule", "label": "Foundation and freeboard gated on hydraulic and geotechnical design",
     "regex": "hydraulic and geotechnical design before advancing",
     "rules": [{"classes": ["IfcFooting"], "require": {"DesignStatus": {"not_regex": "final|issued|approved"}},
                "message": "{elements}: foundation design is '{actual}', but the document requires hydraulic and geotechnical design to be completed first."},
               {"when": {"Freeboard": {"present": true}}, "require": {"DesignStatus": {"not_regex": "final|issued|approved"}},
                "message": "{elements}: freeboard design is '{actual}', but the document requires hydraulic design to be completed first."}]},
    {"id": "confirm_crossfall", "kind": "rule", "label": "Deck drainage crossfall to be confirmed",
     "regex": "confirm[^.]{0,60}crossfall",
     "rules": [{"classes": ["IfcSlab"], "require": {"Crossfall|CrossfallPercent|CrossSlope": {"present": true}},
                "kind": "missing", "severity": "medium",
                "message": "The document asks for the deck drainage crossfall to be confirmed, but {elements} has no crossfall value."}]},
    {"id": "retain_access", "kind": "rule", "label": "Access must be retained",
     "regex": "\\bretain access\\b",
     "rules": [{"when": {"AccessRetained": {"present": true}}, "require": {"AccessRetained": {"eq": true}},
                "message": "{elements}: the document requires access to be retained, but the model has AccessRetained = {actual}."}]},
    {"id": "maintain_traffic", "kind": "rule", "label": "Traffic maintained during construction",
     "regex": "\\bmaintain traffic during construction",
     "rules": [{"when": {"Strategy": {"present": true}}, "require": {"Strategy": {"not_regex": "closure"}},
                "message": "{elements}: the document requires traffic to be maintained during construction, but the model strategy is '{actual}'."}]},
    {"id": "accepted_tap", "kind": "rule", "label": "Traffic accommodation plan must be accepted",
     "regex": "accepted traffic accommodation plan",
     "rules": [{"when": {"AcceptanceStatus": {"present": true}}, "require": {"AcceptanceStatus": {"regex": "^\\s*accepted"}},
                "message": "{elements}: the document requires an accepted traffic accommodation plan, but its status is '{actual}'."}]},
    {"id": "combined_traffic", "kind": "rule", "label": "Combined development and background traffic",
     "regex": "combined development and background traffic",
     "rules": [{"when": {"TrafficScenario": {"present": true}}, "require": {"TrafficScenario": {"not_regex": "background only"}},
                "message": "{elements}: the document requires combined development and background traffic, but the model analysis uses '{actual}'."}]},
    {"id": "deliverable_pavement_memo", "kind": "rule", "label": "Pavement memorandum deliverable",
     "regex": "pavement memorandum",
     "rules": [{"when": {"PavementMemorandumRef": {"present": true}}, "require": {"PavementMemorandumRef": {"not_regex": "^\\s*none\\s*$"}},
                "kind": "missing", "message": "The document lists a pavement memorandum as a deliverable, but {elements} references '{actual}'."}]},
    {"id": "deliverable_survey_geotech", "kind": "rule", "label": "Survey and geotechnical summary deliverable",
     "regex": "survey/geotechnical summary",
     "rules": [{"when": {"SurveyGeotechSummaryRef": {"present": true}}, "require": {"SurveyGeotechSummaryRef": {"not_regex": "^\\s*none\\s*$"}},
                "kind": "missing", "message": "The document lists a survey and geotechnical summary as a deliverable, but {elements} references '{actual}'."}]},
    {"id": "deliverable_tia", "kind": "rule", "label": "Traffic impact assessment deliverable",
     "regex": "traffic impact assessment",
     "rules": [{"when": {"TrafficImpactAssessmentStatus": {"present": true}}, "require": {"TrafficImpactAssessmentStatus": {"not_regex": "not started"}},
                "kind": "missing", "message": "The document lists a traffic impact assessment as a deliverable, but the model records it as '{actual}'."}]},
    {"id": "two_lane", "kind": "rule", "label": "Two-lane corridor",
     "regex": "\\btwo-lane\\b",
     "rules": [{"classes": ["IfcRoad"], "when": {"ThroughLanes": {"present": true}}, "require": {"ThroughLanes": {"eq": 2}},
                "message": "{elements}: the document describes a two-lane corridor, but the model has {actual} through lanes."}]},

    {"id": "edition", "kind": "edition", "label": "Referenced standard edition",
     "regex": "(?P<subject>(?:[A-Z][A-Za-z]+\\s+){1,8}(?:Criteria|Standards?|Code|Manual|Guide|Guidelines|Specifications?)),?\\s+(?:Version|v)\\s*(?P<ver>\\d+(?:\\.\\d+)?)"}
  ]
}
