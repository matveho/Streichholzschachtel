#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
case "${1:-status}" in
 start) systemctl --user start basis-backend basis-gateway ;;
 stop) systemctl --user stop basis-gateway basis-backend ;;
 reindex) systemctl --user restart basis-backend ;;
 restart) systemctl --user restart basis-backend basis-gateway ;;
 status) systemctl --user status basis-backend basis-gateway --no-pager ;;
 logs) journalctl --user -u basis-backend -u basis-gateway -f ;;
 health) node --input-type=module -e 'const h=await (await fetch("http://127.0.0.1:8787/health", {signal:AbortSignal.timeout(5000)})).json(); console.log(JSON.stringify(h,null,2)); process.exit(h.ready && !h.failures ? 0 : 1)' ;;
 mode)
   mode="${2:-}"
   if [[ "$mode" != extractive && "$mode" != comparisons && "$mode" != demo ]]; then
     echo 'Usage: basis mode extractive|comparisons|demo' >&2
     exit 2
   fi
   if [[ "$mode" != extractive ]]; then
     systemctl --user start basis-ollama
     node scripts/linux/prepare-comparison-model.mjs
   fi
   directory="$HOME/.config/systemd/user/basis-backend.service.d"
   mkdir -p "$directory"
   if [[ "$mode" != extractive ]]; then
     cat > "$directory/mode.conf" <<UNIT
[Service]
Environment=GENERATION_PROVIDER=ollama
Environment=EXTRACTIVE_ONLY=0
Environment=LOCAL_SYNTHESIS=1
Environment=LOCAL_SYNTHESIS_POLICY=$mode
Environment=LOCAL_REASONING=0
Environment=LOCAL_CONTEXT_TOKENS=16384
Environment=OLLAMA_URL=http://127.0.0.1:11435
Environment=OLLAMA_MODEL=basis-qwen35-comparisons:72aac7c28be8
UNIT
   else
     cat > "$directory/mode.conf" <<'UNIT'
[Service]
Environment=GENERATION_PROVIDER=extractive
Environment=EXTRACTIVE_ONLY=1
Environment=LOCAL_SYNTHESIS=0
UNIT
   fi
   systemctl --user daemon-reload
   systemctl --user restart basis-backend
   node --input-type=module - <<'JS'
for(let i=0;i<120;i++){
 try{const h=await(await fetch('http://127.0.0.1:8787/health')).json();if(h.ready&&!h.failures){console.log('Ready:',h.generationPolicy,h.model);process.exit(0)}}catch{}
 await new Promise(r=>setTimeout(r,1000));
}
throw Error('Backend did not become ready; inspect basis logs or restore basis mode extractive.');
JS
   ;;
 check) BASIS_FRONTEND_URL=http://127.0.0.1:8789/app node backend/tests/presentation.smoke.mjs ;;
 prepare-demo) node scripts/linux/prepare-demo.mjs ;;
 rebuild-interface) npm run build; node scripts/linux/publish-interface.mjs ;;
 *) echo 'Usage: basis start|stop|restart|reindex|status|logs|health|check|prepare-demo|rebuild-interface|mode extractive|comparisons|demo'; exit 2 ;;
esac
