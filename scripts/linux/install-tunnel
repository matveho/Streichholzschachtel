#!/usr/bin/env bash
# Run only with authorization to expose this workstation.
set -euo pipefail
mkdir -p "$HOME/.local/bin" "$HOME/.config/systemd/user"
curl -fL --retry 2 https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-linux-amd64 -o "$HOME/.local/bin/cloudflared.download"
printf '1f99fb518b83dec2ba8d870a7cc991d82a77e6196295a3d2754ba17ab9f91872  %s\n' "$HOME/.local/bin/cloudflared.download" | sha256sum -c -
chmod 700 "$HOME/.local/bin/cloudflared.download"
mv "$HOME/.local/bin/cloudflared.download" "$HOME/.local/bin/cloudflared"
cat > "$HOME/.config/systemd/user/basis-tunnel.service" <<UNIT
[Unit]
Description=basis authorized demo HTTPS tunnel
After=basis-gateway.service
Requires=basis-gateway.service
[Service]
ExecStart="$HOME/.local/bin/cloudflared" tunnel --url http://127.0.0.1:8789 --no-autoupdate
Restart=on-failure
RestartSec=5
UMask=0077
UNIT
systemd-analyze --user verify "$HOME/.config/systemd/user/basis-tunnel.service"
systemctl --user daemon-reload
printf 'Start: systemctl --user start basis-tunnel\nFind URL: journalctl --user -u basis-tunnel --no-pager\nA new tunnel URL requires updating the Vercel project route.\n'
