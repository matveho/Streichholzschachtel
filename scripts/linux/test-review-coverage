#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
systemctl --user start basis-ollama
node scripts/linux/prepare-comparison-model.mjs
export BASIS_STATE_DIR
BASIS_STATE_DIR=$(mktemp -d "$PWD/backend/state/verification/run-browser-XXXXXXXX")
export PDF_CACHE_DIR="$PWD/backend/state"
export EXTRACTIVE_ONLY=0 GENERATION_PROVIDER=ollama LOCAL_SYNTHESIS=1 LOCAL_SYNTHESIS_POLICY=all LOCAL_REASONING=0
export OLLAMA_URL=http://127.0.0.1:11435 OLLAMA_MODEL=basis-qwen35-comparisons:72aac7c28be8
export TESSERACT_PATH="$HOME/.local/share/basis-ocr/usr/bin/tesseract"
export TESSDATA_PREFIX="$HOME/.local/share/basis-ocr/usr/share/tesseract-ocr/5/tessdata"
export BASIS_FRONTEND_URL=http://127.0.0.1:8842/app
printf 'Review coverage browser state: %s\n' "$BASIS_STATE_DIR"
PORT=8840 node backend/src/server.mjs > "$BASIS_STATE_DIR/server.log" 2>&1 &
api_pid=$!
BASIS_GATEWAY_PORT=8842 BASIS_GATEWAY_TARGET=http://127.0.0.1:8840 node backend/demo-gateway.mjs > "$BASIS_STATE_DIR/gateway.log" 2>&1 &
gateway_pid=$!
trap 'kill "$gateway_pid" "$api_pid" 2>/dev/null || true; wait "$gateway_pid" "$api_pid" 2>/dev/null || true' EXIT
node --input-type=module - <<'JS'
for(let i=0;i<600;i++){
 try {const h=await(await fetch('http://127.0.0.1:8842/local-api/health')).json();if(h.ready&&!h.failures&&h.generationPolicy==='all')process.exit(0)}catch{}
 await new Promise(resolve=>setTimeout(resolve,1000));
}
throw Error('Isolated review backend not ready');
JS
kill -0 "$api_pid" "$gateway_pid"
for suite in ${BASIS_BROWSER_SUITES:-review-coverage}; do
  case "$suite" in review-coverage|arithmetic) ;; *) printf 'Unknown browser suite: %s\n' "$suite" >&2; exit 1 ;; esac
  node "backend/tests/$suite.browser.mjs" > "$BASIS_STATE_DIR/$suite.log" 2>&1
  printf 'PASS %s browser workflow\n' "$suite"
done
