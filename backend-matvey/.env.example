# Optional overrides. Copy to .env; no API key is required.
PORT=8787
# Leave unset to open the bundled frontend, served by the launcher.
# FRONTEND_URL=https://streichholzschachtel.vercel.app
# Comma-separated additional browser origins, including a preview URL if needed.
ALLOWED_ORIGINS=

# Answer engine:
#   auto       (default) Claude when ANTHROPIC_API_KEY is set, otherwise extractive
#   extractive offline: verbatim table rows/clauses + document version checks
#   anthropic  Claude writes the answer from the extractive engine's cited units
#   ollama     earlier local-model pipeline (downloads a model on first launch)
#   gateway    earlier Vercel AI Gateway pipeline
GENERATION_PROVIDER=auto
# Never commit a real key. Questions and retrieved excerpts are sent to Anthropic.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Legacy pipelines
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
AI_GATEWAY_MODEL=google/gemini-4-argon
# AI_GATEWAY_API_KEY=
# Use 1 to force the offline extractive engine.
EXTRACTIVE_ONLY=0
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
