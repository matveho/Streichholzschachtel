# Optional overrides. Copy to .env; no API key is required.
PORT=8787
# Leave unset to open the bundled frontend, served by the launcher.
# FRONTEND_URL=https://streichholzschachtel.vercel.app
# Comma-separated additional browser origins, including a preview URL if needed.
ALLOWED_ORIGINS=
# Use 1 for retrieval/excerpts without local-model generation.
EXTRACTIVE_ONLY=0
# Enable the local consolidated-answer path; complex-query quality is still being improved.
LOCAL_SYNTHESIS=1
# Optional hosted synthesis. Never commit the API key. Defaults to local Ollama.
GENERATION_PROVIDER=ollama
# Use extractive for the offline table/provision lookup added by conversation-layer.
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
AI_GATEWAY_MODEL=google/gemini-4-argon
# AI_GATEWAY_API_KEY=
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# Optional offline contradiction veto. It never approves a claim or replaces numeric checks.
# ENTAILMENT_MODEL_DIR=E:/Basis-model-cache/model
# ENTAILMENT_PYTHON=E:/Basis-model-cache/.venv/Scripts/python.exe
# Optional experimental local runtime. Keep the default Ollama provider until validated.
# GENERATION_PROVIDER=llamacpp
# LOCAL_MODEL_URL=http://127.0.0.1:11436
# LOCAL_MODEL_NAME=basis-qwen35
# LOCAL_MODEL_KEY_FILE=E:/Basis-model-cache/runtime-key.txt
# LOCAL_MODEL_MANIFEST=E:/Basis-model-cache/qwen35-source.json
# LOCAL_MODEL_RELEASE_FOR_VERIFIER=1
