# Optional overrides. Copy to .env; no API key is required.
PORT=8787
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Leave unset to open the bundled frontend, served by the launcher.
# FRONTEND_URL=https://streichholzschachtel.vercel.app
# Comma-separated additional browser origins, including a preview URL if needed.
ALLOWED_ORIGINS=
# Use 1 for retrieval/excerpts without local-model generation.
EXTRACTIVE_ONLY=0
# Optional hosted synthesis. Never commit the API key. Defaults to local Ollama.
GENERATION_PROVIDER=ollama
AI_GATEWAY_MODEL=google/gemini-4-argon
# AI_GATEWAY_API_KEY=
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
